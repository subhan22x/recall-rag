# Local PostgreSQL from docker-compose.yml
DATABASE_URL=postgresql://recallops:recallops@localhost:5433/recallops
ANALYTICS_DATABASE_URL=postgresql://recallops_ro:recallops_ro@localhost:5433/recallops

# Configure these to enable the real OpenAI-backed route/parser/composer.
# Without this key the app stays runnable using a clearly marked deterministic development fallback.
OPENAI_API_KEY=
# Optional OpenAI-compatible endpoint, e.g. https://openrouter.ai/api/v1
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-5.4
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

RECALLOPS_PORT=8010
RECALLOPS_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Optional for a deliberately remote/reverse-proxied MCP HTTP endpoint.
# Without this value, /mcp accepts only loopback clients.
RECALLOPS_MCP_HTTP_TOKEN=
